{
  "name": "@crediflow/decision-engine",
  "version": "1.0.0",
  "description": "Motor de Decisiones Determinístico de CrediFlow CRM (Credit Libranzas) - Arquitectura Hexagonal basada en Features + DDD",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.ts",
    "api": "node src/interfaces/http/server.ts",
    "simulator": "node src/interfaces/cli/simulator.ts",
    "simulator:presets": "node src/interfaces/cli/simulator.ts --all-presets",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
